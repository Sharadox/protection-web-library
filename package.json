{
  "name": "@sharadox/protection-web-library",
  "version": "0.1.0",
  "description": "Protection for web forms and APIs: layered rate limits, proof-of-work challenges and spending caps.",
  "private": false,
  "license": "SEE LICENSE IN LICENCA.md",
  "author": "Sharadox <contact@sharadox.com>",
  "type": "module",
  "exports": {
    "./*/type": {
      "sharadox-source": "./source/*/type.ts",
      "types": "./distribution/*/type.d.ts"
    },
    "./*": {
      "sharadox-source": [
        "./source/*/index.ts"
      ],
      "types": "./distribution/*/index.d.ts",
      "default": "./distribution/*/index.js"
    }
  },
  "files": [
    "distribution",
    "LICENCA.md",
    "LICENSE.md",
    "NOTICE.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.34.9",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "library-build",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run --coverage",
    "test:benchmark": "vitest bench --run --passWithNoTests",
    "documentation": "typedoc",
    "verify": "turbo run format:check lint type-check test:unit test:benchmark build",
    "prepare": "turborepo-configuration library && (husky || true)"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@sharadox/database-web-library": "0.1.0-development.6",
    "@sharadox/web-library": "^0.11.1",
    "kysely": "^0.28.19"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@sharadox/es-lint-configuration-web-library": "^0.1.3",
    "@sharadox/library-build-web-library": "^0.2.1",
    "@sharadox/prettier-configuration-web-library": "^0.1.2",
    "@sharadox/turborepo-configuration-web-library": "^0.1.4",
    "@sharadox/type-script-configuration-web-library": "^0.2.3",
    "@sharadox/vitest-configuration-web-library": "^0.2.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "9.39.5",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sharadox/protection-web-library.git"
  },
  "homepage": "https://github.com/Sharadox/protection-web-library#readme",
  "keywords": [
    "rate-limit",
    "proof-of-work",
    "abuse",
    "denial-of-wallet",
    "security",
    "forms"
  ]
}
